# TRIPYYY environment variables
# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Every section except AI is optional: a feature switches on only when its keys are present.

# ── AI (required) ────────────────────────────────────────────────────────────
# gemini (free tier, development) | openai (production) | mock (offline sample plans)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional override; defaults to gemini-flash-latest with automatic fallbacks.
# GEMINI_MODEL=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Fallback chain. If a model is busy, rate-limited, erroring or silent for 60s, the next one takes over.
# Default: AI_PROVIDER's models first, then the other provider's (only those whose API key is set).
# AI_MODELS=gemini:gemini-flash-latest,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,openai:gpt-4o-mini
# Plans per user (or per IP for guests) per hour.
GENERATE_LIMIT_PER_HOUR=5

# ── Site ─────────────────────────────────────────────────────────────────────
# Public URL, used for share-link previews. e.g. https://tripyyy.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database: Supabase Postgres (saved trips + share links) ─────────────────
# Pooled connection (port 6543) — used by the running app.
DATABASE_URL=
# Direct connection (port 5432) — used only by `npm run db:deploy` / migrations.
DIRECT_URL=

# ── Sign-in: NextAuth (needs the database above) ────────────────────────────
# Generate with: npx auth secret   (or any 32+ random characters)
NEXTAUTH_SECRET=
# The site URL again, e.g. http://localhost:3000 locally or your Vercel URL in production.
NEXTAUTH_URL=http://localhost:3000
# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email magic links via Resend (optional)
RESEND_API_KEY=
EMAIL_FROM="TRIPYYY <login@yourdomain.com>"

# ── Rate limiting across servers: Upstash Redis (recommended in production) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Error monitoring: Sentry (optional) ─────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time:
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
